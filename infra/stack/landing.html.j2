    }
    .section {
      padding-block:112px;
      scroll-margin-top:30px;
    }
    .section-intro {
      display:grid;
      grid-template-columns:1fr 2.1fr;
      gap:60px;
      margin-bottom:58px;
    }
    .section-label {
      color:var(--muted);
      display:flex;
      gap:16px;
      padding-top:10px;
    }
    .section-label b {
