    "list": [
      {
        "name": "stack",
        "label": "Stack",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "refId": "stack",
          "type": 1,
          "label": "stack",
          "stream": ""
        },
        "definition": "label_values(stack)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": []
      },
      {
        "name": "node",
        "label": "Worker",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "refId": "node",
          "type": 1,
          "label": "node",
          "stream": "{stack=~`${stack:regex}`}"
        },
        "definition": "label_values({stack=~`${stack:regex}`}, node)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
