      }
      .research {
        margin-bottom:0;
      }
      .research p {
        font-size:14px;
      }
      .closing {
        padding-block:60px;
      }
      .closing-inner {
        align-items:flex-start;
        flex-direction:column;
        gap:32px;
      }
      .closing h2 {
        font-size:53px;
      }
      .closing .mono {
