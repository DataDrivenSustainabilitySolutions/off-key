      .hero-photo { height:clamp(340px,48svh,440px); aspect-ratio:auto; }
      .hero-title { padding:16px 22px 36px; }
      .hero-title > .mono { max-width:310px; font-size:8px; line-height:1.6; margin:0 auto 17px; }
      .hero h1 { font-size:44px; max-width:390px; line-height:1.04; margin:auto; }
      .hero-title .hero-promise { margin-top:13px; font-size:21px; }
