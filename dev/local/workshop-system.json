{
  "format": "aberration-system",
  "schema_version": 1,
  "label": "Local workshop",
  "default_policy": { "mode": "off", "interval_seconds": 10 },
  "connections": [
    {
      "id": "local-workshop-broker",
      "label": "Workshop broker",
      "protocol": "mqtt",
      "host": "source-broker",
      "port": 1883,
      "transport": "tcp",
      "tls": false
    }
  ],
  "devices": [
    {
      "id": "local-office",
      "label": "Office",
      "kind": "room",
      "connection_id": "local-workshop-broker"
    },
    {
      "id": "local-machinery",
      "label": "Workbench",
      "kind": "machine",
      "connection_id": "local-workshop-broker"
    }
  ],
  "streams": [
    {
      "id": "local-temperature",
      "label": "Ambient temperature",
      "connection_id": "local-workshop-broker",
      "device_id": "local-office",
      "topic": "workshop/office/environment",
      "payload_pointer": "/temperature",
      "value_type": "number",
      "unit": "°C",
      "category": "Environment"
    },
    {
      "id": "local-humidity",
      "label": "Humidity",
      "connection_id": "local-workshop-broker",
      "device_id": "local-office",
      "topic": "workshop/office/environment",
      "payload_pointer": "/humidity",
      "value_type": "number",
      "unit": "%",
      "category": "Environment"
    },
    {
      "id": "local-vibration",
      "label": "Vibration",
      "connection_id": "local-workshop-broker",
      "device_id": "local-machinery",
      "topic": "workshop/workbench/vibration",
      "payload_pointer": "/rms",
      "value_type": "number",
      "unit": "mm/s",
      "category": "Condition"
    },
    {
      "id": "local-running",
      "label": "Running",
      "connection_id": "local-workshop-broker",
      "device_id": "local-machinery",
      "topic": "workshop/workbench/status",
      "payload_pointer": "/running",
      "value_type": "boolean",
      "category": "Condition"
    },
    {
      "id": "local-mode",
      "label": "Operating mode",
      "connection_id": "local-workshop-broker",
      "device_id": "local-machinery",
      "topic": "workshop/workbench/status",
      "payload_pointer": "/mode",
      "value_type": "text",
      "category": "Condition"
    },
    {
      "id": "local-cycle",
      "label": "Cycle identifier",
      "connection_id": "local-workshop-broker",
      "device_id": "local-machinery",
      "topic": "workshop/workbench/status",
      "payload_pointer": "/cycle_id",
      "value_type": "identifier",
      "category": "Condition"
    }
  ],
  "groups": [
    {
      "id": "local-environment-group",
      "label": "Environment",
      "color": "#5e8d84",
      "member_ids": ["local-office", "local-temperature", "local-humidity"]
    },
    {
      "id": "local-machinery-group",
      "label": "Equipment",
      "color": "#9b8bb8",
      "member_ids": [
        "local-machinery",
        "local-vibration",
        "local-running",
        "local-mode",
        "local-cycle"
      ]
    }
  ]
}
