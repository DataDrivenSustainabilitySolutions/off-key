{
  "description": "Broker, reading and group cases that the backend SystemDocument model and the frontend validator must judge alike; the backend is canonical.",
  "default_group_color": "#397f74",
  "base": {
    "format": "aberration-system",
    "schema_version": 1,
    "label": "Conformance",
    "default_policy": {"mode": "off", "interval_seconds": 10},
    "brokers": [
      {"id": "broker", "label": "Broker", "protocol": "mqtt", "host": "broker.example.test", "port": 1883, "transport": "tcp", "tls": false}
    ],
    "devices": [],
    "readings": [],
    "groups": []
  },
  "cases": [
    {"name": "hostname", "valid": true, "connection": {"host": "broker.example.test"}},
    {"name": "trailing dot hostname", "valid": true, "connection": {"host": "broker.example.test."}},
    {"name": "IPv4", "valid": true, "connection": {"host": "192.168.1.20"}},
    {"name": "IPv6", "valid": true, "connection": {"host": "2001:db8::1"}},
    {"name": "IPv4-mapped IPv6", "valid": true, "connection": {"host": "::ffff:1.2.3.4"}},
    {"name": "colons only", "valid": false, "connection": {"host": ":::::"}},
    {"name": "scoped IPv6", "valid": false, "connection": {"host": "fe80::1%eth0"}},
    {"name": "URL instead of host", "valid": false, "connection": {"host": "mqtt://broker.example.test"}},
    {"name": "host with port", "valid": false, "connection": {"host": "broker.example.test:1883"}},
    {"name": "websocket path", "valid": true, "connection": {"transport": "websocket", "websocket_path": "/mqtt"}},
    {"name": "websocket path with a no-break space", "valid": true, "connection": {"transport": "websocket", "websocket_path": "/mqtt feed"}},
    {"name": "websocket path with a space", "valid": false, "connection": {"transport": "websocket", "websocket_path": "/mqtt feed"}},
    {"name": "websocket path with a fragment", "valid": false, "connection": {"transport": "websocket", "websocket_path": "/mqtt#feed"}},
    {"name": "relative websocket path", "valid": false, "connection": {"transport": "websocket", "websocket_path": "mqtt"}},
    {"name": "websocket path on TCP", "valid": false, "connection": {"transport": "tcp", "websocket_path": "/mqtt"}},
    {"name": "HTTP source", "valid": true, "connection": {"protocol": "http", "port": 8080}},
    {"name": "HTTP source with TLS", "valid": true, "connection": {"protocol": "http", "port": 443, "tls": true}},
    {"name": "HTTP source over a WebSocket transport", "valid": false, "connection": {"protocol": "http", "port": 8080, "transport": "websocket"}},
    {"name": "HTTP source with a WebSocket path", "valid": false, "connection": {"protocol": "http", "port": 8080, "transport": "websocket", "websocket_path": "/mqtt"}},
    {"name": "unknown protocol", "valid": false, "connection": {"protocol": "amqp"}},
    {"name": "MQTT topic", "valid": true, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "site/room 1/temperature"}},
    {"name": "MQTT topic with a wildcard", "valid": false, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "site/+/temperature"}},
    {"name": "MQTT reading with a source timestamp", "valid": false, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "site/room/temperature", "timestamp_pointer": "/at"}},
    {"name": "HTTP request path", "valid": true, "connection": {"protocol": "http", "port": 8080}, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "/api/v1/status?device=1&unit=°C", "payload_pointer": "/sensors/temperature", "timestamp_pointer": "/updated_at"}},
    {"name": "HTTP root path", "valid": true, "connection": {"protocol": "http", "port": 8080}, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "/"}},
    {"name": "relative HTTP request path", "valid": false, "connection": {"protocol": "http", "port": 8080}, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "api/v1/status"}},
    {"name": "HTTP request path with a space", "valid": false, "connection": {"protocol": "http", "port": 8080}, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "/api/v1/status one"}},
    {"name": "HTTP request path with a fragment", "valid": false, "connection": {"protocol": "http", "port": 8080}, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "/api/v1/status#one"}},
    {"name": "HTTP request path with a plus", "valid": false, "connection": {"protocol": "http", "port": 8080}, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "/api/v1/status?q=a+b"}},
    {"name": "source timestamp that is not a pointer", "valid": false, "connection": {"protocol": "http", "port": 8080}, "reading": {"id": "reading", "label": "Reading", "broker_id": "broker", "topic": "/api/v1/status", "timestamp_pointer": "updated_at"}},
    {"name": "group without a colour", "valid": true, "group": {"id": "group", "label": "Group", "member_ids": ["broker"]}},
    {"name": "group with a short colour", "valid": false, "group": {"id": "group", "label": "Group", "color": "#abc", "member_ids": []}}
  ]
}
