    }
    html {
      scroll-behavior:smooth;
    }
    body {
      margin:0;
      min-width:320px;
      font-size:15px;
      line-height:1.6;
    }
    a {
      color:inherit;
      text-decoration:none;
    }
    a:focus-visible,summary:focus-visible {
