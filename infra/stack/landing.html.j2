<!doctype html>
{% set hero_slides = [
  ('bridge', 'strain', 'hero-bridge-v1.jpg', 1942, 'a steel bridge'),
  ('cables', 'traffic', 'hero-data-cable-runway-v1.webp', 1942, 'a data-centre cable runway'),
  ('pipes', 'flow', 'hero-pipes-v1.webp', 1944, 'an industrial pipe rack'),
  ('conveyor', 'quality', 'hero-conveyor-v1.webp', 1942, 'a powered roller conveyor'),
  ('solar', 'yield', 'hero-solar-v2.webp', 1944, 'a solar canopy with paired steel support columns'),
  ('cooling', 'efficiency', 'hero-cooling-bank-v1.webp', 1942, 'an industrial cooling bank'),
  ('gantry', 'precision', 'hero-robotic-gantry-v1.webp', 1942, 'an overhead robotic gantry'),
  ('irrigation', 'pressure', 'hero-irrigation-span-v2.webp', 1944, 'a centre-pivot irrigation span')
] %}
{% set hero_slide_seconds = 6.5 %}
{% set hero_crossfade_seconds = 2 %}
{% set hero_cycle_seconds = hero_slides | length * hero_slide_seconds %}
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="description" content="Anomaly detection for sensor telemetry and digital data streams. Turn streaming data into evidence of change.">
  <meta name="theme-color" content="#08090a">
  <title>Aberration</title>
  <link rel="canonical" href="https://{{ ingress_base_domain | e }}/">
  <link rel="alternate" type="text/markdown" href="/index.md" title="Aberration as Markdown">
  <link rel="describedby" type="text/plain" href="/llms.txt" title="llms.txt">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%20width%3D%2264%22%20height%3D%2264%22%20role%3D%22img%22%3E%0A%20%20%3Ctitle%3EAberration%3C%2Ftitle%3E%0A%20%20%3Crect%20width%3D%2264%22%20height%3D%2264%22%20fill%3D%22%23000%22%2F%3E%0A%20%20%3Cpath%20id%3D%22mark%22%20fill%3D%22%23fff%22%20d%3D%22M10%2010H38V20H20V54H10ZM44%2010H54V54H26V44H44Z%22%2F%3E%0A%3C%2Fsvg%3E%0A">
  <style>
    /* Script-free landing page with photographs served from the same origin. */
    .site-footer {
      border-top: 1px solid var(--line);
    }
    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px 24px;
      padding-block: 16px;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .04em;
    }
    .footer-brand {
      margin: 0;
      color: var(--ink);
    }
    .footer-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px 24px;
    }
    .footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .footer-links a:hover, .legal-close:hover {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .legal-panel {
      display: none;
      padding-block: 32px 40px;
      border-top: 1px solid var(--line);
      overflow-wrap: anywhere;
      scroll-margin-top: 24px;
    }
    .legal-panel:target {
      display: block;
    }
    .legal-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      max-width: 760px;
    }
    .legal-heading h2 {
      font-size: 23px;
    }
    .legal-close {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--muted);
      font-size: 12px;
    }
    .legal-template {
      max-width: 760px;
      margin: 12px 0 24px;
      color: var(--muted);
      font-size: 13px;
    }
    .legal-details {
      display: grid;
      grid-template-columns: minmax(140px, 1fr) 3fr;
      gap: 16px 32px;
      max-width: 760px;
      margin: 0;
      font-size: 13px;
      line-height: 1.7;
    }
    .legal-details dt {
      font-weight: 500;
    }
    .legal-details dd {
      min-width: 0;
      margin: 0;
      color: var(--muted);
    }
    .legal-panel:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 4px;
    }
    @media (max-width: 760px) {
      .footer-inner {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
        padding-block: 20px;
      }
      .legal-details {
        grid-template-columns: 1fr;
        gap: 4px;
      }
      .legal-details dd + dt {
        margin-top: 16px;
      }
    }
    :root {
      color-scheme:dark;
      --bg:#08090a;
      --ink:#f2f1ed;
      --muted:#95979b;
      --line:#292b2e;
      --accent:#d69b7b;
      --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
      background:var(--bg);
      color:var(--ink);
      font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;
      -webkit-font-smoothing:antialiased;
    }
    * {
