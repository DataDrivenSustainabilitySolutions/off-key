{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/Tests/**/*.test.{ts,tsx}",
    "e2e/**/*.{spec,setup}.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "*.{ts,js}"
  ],
  "ignore": [
    "src/types/pipelines.generated.ts",
    "src/types/dojo.generated.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tailwindcss-animate"
  ]
}
