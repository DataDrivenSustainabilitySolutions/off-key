      "type": "link",
      "title": "04 · HTTP & access",
      "url": "/d/aberration-access",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Reading this dashboard",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**Choose the worker and service, then paste an incident reference.** All panels use the same Service, Worker, Level and literal Contains filters. Expand a record to inspect its original fields.\n\nNewest **200 lines** are shown per log panel; narrow the time range or continue in Explore for more. Level is Loki's detected severity (unclassified records remain available). Manager-only services and collector self-logs are outside this worker log collection. Auto-refresh is off while investigating."
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "row",
      "title": "Matching records · selected scope",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Matching lines observed",
      "description": "Count across the selected range, not just the newest 200 displayed below. Empty means no matching records; it does not prove a healthy service.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({stack=~`${stack:regex}`,node=~`${node:regex}`,service=~`${service:regex}`} | detected_level=~${severity:doublequote} | json search_message=\"message\" | drop __error__, __error_details__ | label_format line_matches=`{{ if or (eq \"${search:percentencode}\" \"\") (contains (lower (urldecode \"${search:percentencode}\")) (lower (__line__))) (contains (lower (urldecode \"${search:percentencode}\")) (lower .search_message)) }}yes{{ end }}` | line_matches=\"yes\" | drop line_matches, search_message | drop msg [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{service}}"
        }
      ],
      "interval": "1m",
      "maxDataPoints": 180,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No observations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Services with matching lines",
      "description": "Observed services in this filtered range, not desired service replicas.",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 4
