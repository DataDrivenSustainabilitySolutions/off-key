          "editorMode": "code",
          "expr": "sum by (detected_level) (count_over_time({stack=~`${stack:regex}`,node=~`${node:regex}`,service=~`${service:regex}`} | detected_level=~${severity:doublequote} | json search_message=\"message\" | drop __error__, __error_details__ | label_format line_matches=`{{ if or (eq \"${search:percentencode}\" \"\") (contains (lower (urldecode \"${search:percentencode}\")) (lower (__line__))) (contains (lower (urldecode \"${search:percentencode}\")) (lower .search_message)) }}yes{{ end }}` | line_matches=\"yes\" | drop line_matches, search_message | drop msg [$__interval]))",
