    {
      "id": 3,
      "type": "stat",
      "title": "Collector errors",
      "description": "Observed collector/ingress exception records; retries can create several records for one outage.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({stack=~`${stack:regex}`,node=~`${node:regex}`,service=~`${stack:regex}_(mqtt-proxy|tactic)`} |~ `Collection failed|System ingress interrupted; retrying` | drop msg [$__range])) or (0 * sum(count_over_time({stack=~`${stack:regex}`,node=~`${node:regex}`,service=~`${stack:regex}_(mqtt-proxy|tactic)`} [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{service}}"
        }
      ],
      "interval": "1m",
      "maxDataPoints": 180,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No observations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
