# ----------------------------------------
# External Ingress (Tailscale VPN + gost TCP forwarder → EMQX bridge)
# Copy to .env.ingress.local and fill values.
#
# Deploy with:
#   docker compose \
#     --env-file .env \
#     --env-file .env.ingress.local \
#     -f docker-compose.swarm.yml \
#     -f docker-compose.ingress.yml \
#     config \
#     | docker stack deploy --with-registry-auth -c - off-key
#
# The catalog controller creates per-broker EMQX sources and routes.
# Supply existing vendor MQTT access and private EMQX/GOST controller credentials.
# Production off-key-infra uses targeted Swarm secrets instead of this env file.
# Add broker hostnames and sensor definitions in the Data sources UI.
# ----------------------------------------

# Tailscale login behavior:
# - INGRESS_TS_AUTH_ONCE=true (recommended) reuses persisted state; only logs in when needed.
# - INGRESS_TS_AUTHKEY is required for the first login; optional after state is pre-seeded.
INGRESS_TS_AUTH_ONCE=true
INGRESS_TS_AUTHKEY=

# Optional: extra tailscale flags (e.g. --login-server, --hostname, --accept-dns=false).
INGRESS_TS_EXTRA_ARGS=--accept-dns=false

# Host path for persisted Tailscale state (must exist on the backend node before deploy).
# Seed with tailscaled.state from a pre-authenticated installation to avoid runtime auth.
INGRESS_TS_STATE_DIR=/opt/stacks/off-key/tailscale-ingress-state

# Reuse the vendor MQTT credentials; this is separate from tailnet authentication.
AMBIBOX_MQTT_USERNAME=
AMBIBOX_MQTT_PASSWORD=

# Private controller API credentials (must match the EMQX bootstrap file).
AMBIBOX_EMQX_API_KEY=
AMBIBOX_EMQX_API_SECRET=
AMBIBOX_GOST_USERNAME=off-key
AMBIBOX_GOST_PASSWORD=
