{
  "uid": "aberration-system-overview",
  "title": "Aberration system overview",
  "description": "Production operations from worker logs in Loki. Check delivery first, then investigate service errors and RADAR failures.",
  "tags": [
    "aberration",
    "operations"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "type": "link",
      "title": "Open detailed logs",
      "url": "/d/aberration-logs/aberration-logs",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workers delivering logs",
      "description": "Workers with a canary in the two minutes before the selected end time. Compare with the number of active Swarm workers.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count(sum by (node) (count_over_time({stack=\"off-key\",service=\"off-key_log-canary\"} |= \"observability_canary\" [2m]))) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "No signal",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error log lines",
      "description": "Error, critical and fatal lines in the selected range. Zero requires a fresh worker canary at the end of the range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({stack=\"off-key\",service=~\".+\",service!=\"off-key_log-canary\"} | detected_level=~\"error|critical|fatal\" [$__auto])) or (0 * sum(count_over_time({stack=\"off-key\",service=\"off-key_log-canary\"} |= \"observability_canary\" [2m])))",
          "queryType": "instant"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "No signal",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "RADAR failure signals",
      "description": "Selected crash, startup, execution, processing and persistence events in the selected range. The count can include multiple lines from the same run.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({stack=\"off-key\",service=~\"radar(-preflight)?|off-key_(mqtt-radar|tactic)\"} |~ \"event=(tactic[.]radar_task_crashed|radar[.](service_start_failed|start_failed|execution_state_uncertain|health_degraded|message_processing_failed|db_batch_write_failed))\\\\b\" [$__auto])) or (0 * sum(count_over_time({stack=\"off-key\",service=\"off-key_log-canary\"} |= \"observability_canary\" [2m])))",
          "queryType": "instant"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "No signal",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Log delivery by worker",
      "description": "Canary records per worker over a rolling five-minute window. Each active worker emits a canary every 30 seconds.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (node) (count_over_time({stack=\"off-key\",service=\"off-key_log-canary\"} |= \"observability_canary\" [5m]))",
          "queryType": "range",
          "legendFormat": "{{node}}"
        }
      ],
      "maxDataPoints": 240,
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Warnings and errors by service",
      "description": "Warning, error, critical and fatal log lines in each time bucket.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({stack=\"off-key\",service=~\".+\",service!=\"off-key_log-canary\"} | detected_level=~\"warn|warning|error|critical|fatal\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service}}"
        }
      ],
      "maxDataPoints": 240,
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 50,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent RADAR failure signals",
      "description": "Start here for the failure context. Expand a line for its fields or open the detailed log dashboard to follow a run.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{stack=\"off-key\",service=~\"radar(-preflight)?|off-key_(mqtt-radar|tactic)\"} |~ \"event=(tactic[.]radar_task_crashed|radar[.](service_start_failed|start_failed|execution_state_uncertain|health_degraded|message_processing_failed|db_batch_write_failed))\\\\b\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
}
