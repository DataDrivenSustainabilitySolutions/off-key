{
  "id": null,
  "uid": "aberration-logs",
  "title": "05 · Log investigation",
  "description": "Scope, correlate and inspect original records from all collected worker services.",
  "tags": [
    "aberration",
    "operations",
    "provisioned"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "stack",
        "label": "Stack",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "refId": "stack",
          "type": 1,
          "label": "stack",
          "stream": ""
        },
        "definition": "label_values(stack)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": []
      },
      {
        "name": "node",
        "label": "Worker",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "refId": "node",
          "type": 1,
          "label": "node",
          "stream": "{stack=~`${stack:regex}`}"
        },
        "definition": "label_values({stack=~`${stack:regex}`}, node)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "refId": "service",
          "type": 1,
          "label": "service",
          "stream": "{stack=~`${stack:regex}`,node=~`${node:regex}`}"
        },
        "definition": "label_values({stack=~`${stack:regex}`,node=~`${node:regex}`}, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "severity",
        "label": "Level",
        "type": "custom",
        "query": "All : .*, Warnings and errors : warn|warning|error|critical|fatal|panic, Errors : error|critical|fatal|panic, Warnings : warn|warning, Info : info, Debug / trace : debug|trace, Unclassified : unknown|^$",
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Case-insensitive literal substring, applied to every panel. Paste a correlation ID, run ID, monitor ID or message fragment.",
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "01 · Operations overview",
      "url": "/d/aberration-system-overview",
      "includeVars": true,
