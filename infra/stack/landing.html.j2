    .product-overview .product-screen-label { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:16px 22px; background:#111416; border-bottom:1px solid #35393c; color:#b0b5b7; font-size:9px; }
    .product-overview .product-screen-label span:last-child { color:var(--accent); }
    .product-overview .product-screen-viewport { overflow-x:auto; }
    .product-overview .product-screenshot { display:block; width:100%; height:auto; }
    .product-overview .product-image-note { margin:18px 0 0; font-size:11px; color:#81868a; line-height:1.7; }
    .product-overview .product-reporting-intro { margin-bottom:46px; }
    .product-overview .product-caption { display:grid; grid-template-columns:1fr 1fr; gap:60px; padding-top:34px; }
    .product-overview .product-caption h3 { margin:0; font-size:30px; line-height:1.2; }
    .product-overview .product-caption p { margin:0; color:#a6a8ab; font-size:14px; max-width:560px; }
    .product-overview .product-caption .product-image-note { margin-top:14px; font-size:11px; color:#81868a; }
    .product-overview .product-band { border-block:1px solid var(--line); background:#0e1012; }
    .product-overview .product-split { display:grid; grid-template-columns:1fr 1fr; gap:100px; align-items:start; margin-top:34px; }
    .product-overview .product-copy h2 { font-size:clamp(34px,3.5vw,50px); }
    .product-overview .product-copy>p { color:#a6a8ab; max-width:490px; font-size:15px; line-height:1.8; margin:24px 0 32px; }
    .product-overview .product-details { margin:0; }
    .product-overview .product-details>div { border-top:1px solid var(--line); padding:20px 0; }
    .product-overview .product-details>div:last-child { padding-bottom:0; }
    .product-overview .product-details dt { font-size:16px; letter-spacing:-.025em; margin-bottom:6px; }
    .product-overview .product-details dd { color:var(--muted); font-size:13px; margin:0; max-width:440px; line-height:1.8; }
    .product-overview .product-docs-link { border-bottom:1px solid var(--product-line); font-size:12px; margin-top:4px; padding-bottom:6px; }
    .product-overview .product-docs-link .arrow { color:var(--accent); }
    .product-overview .product-replay { margin:0; padding:0; list-style:none; }
    .product-overview .product-replay li { border-top:1px solid #3a3d40; padding:24px 0 28px; }
    .product-overview .product-replay li:first-child { padding-top:0; border:0; }
    .product-overview .product-replay li>span { color:var(--accent); font-size:12px; }
    .product-overview .product-replay h3 { margin:12px 0 10px; font-size:24px; }
    .product-overview .product-replay p { margin:0; max-width:470px; font-size:14px; line-height:1.8; color:#a6a8ab; }
    .product-overview .product-loop { display:flex; align-items:center; gap:26px; border-top:1px solid var(--line); padding-top:28px; margin-top:50px; color:#bfc1be; font-size:9px; }
    .product-overview .product-loop>span[aria-hidden] { color:var(--accent); }
    .product-overview .product-loop-note { margin-left:auto; color:#80868a; text-transform:none; letter-spacing:0; font-family:"Helvetica Neue",Helvetica,Arial,sans-serif; font-size:12px; }
    @media(max-width:1100px) {
      .product-overview .product-split { gap:48px; }
    }
    @media(max-width:760px) {
      .product-overview .product-intro { grid-template-columns:1fr; gap:26px; margin-bottom:36px; }
      .product-overview .product-intro p { font-size:15px; margin-top:20px; }
      .product-overview .product-stats { gap:18px; margin-bottom:32px; padding-block:26px; }
      .product-overview .product-stats dt { font-size:12px; line-height:1.4; }
      .product-overview .product-stats dt>span { font-size:48px; margin-bottom:12px; }
      .product-overview .product-stats dd { font-size:11px; line-height:1.6; }
      .product-overview .product-screen-label { font-size:7px; padding:12px 10px; gap:10px; }
      .product-overview .product-caption { grid-template-columns:1fr; gap:18px; padding-top:26px; }
      .product-overview .product-caption h3 { font-size:28px; }
      .product-overview .product-caption p { font-size:13px; }
      .product-overview .product-split { grid-template-columns:1fr; gap:36px; margin-top:26px; }
      .product-overview .product-copy h2 { font-size:36px; }
      .product-overview .product-copy>p { font-size:14px; margin:20px 0 28px; }
      .product-overview .product-replay h3 { font-size:23px; }
      .product-overview .product-replay p { font-size:13px; }
      .product-overview .product-loop { gap:10px; justify-content:space-between; font-size:7px; margin-top:28px; }
      .product-overview .product-loop-note { display:none; }
      .product-overview .closing h2 { font-size:48px; }
    }
    /* End product overview. */
    /* Footer and legal templates: kept separate from the approved page above. */
    .site-footer:focus-visible { outline:none; }
    .site-footer:focus-visible .footer-brand-link { outline:2px solid var(--accent); outline-offset:5px; }
    .site-footer .footer-main { display:grid; grid-template-columns:1.65fr 1fr 1.15fr 1fr; gap:48px; padding-block:54px 42px; }
    .site-footer .footer-identity { min-width:0; }
    .site-footer .footer-brand-link { display:inline-flex; align-items:center; min-height:44px; font-size:26px; font-weight:500; letter-spacing:-1px; }
    .site-footer .footer-identity p { margin:10px 0 0; color:var(--muted); font-size:13px; line-height:1.8; }
    .site-footer .footer-column { display:flex; flex-direction:column; align-items:flex-start; min-width:0; }
    .site-footer .footer-column h2 { color:var(--accent); font-size:12px; font-weight:400; letter-spacing:0; line-height:1.6; margin:12px 0 16px; }
    .site-footer .footer-column a { display:inline-flex; align-items:center; min-height:36px; font-size:13px; color:#a6a8ab; }
    .site-footer .footer-column a:hover,.site-footer .footer-brand-link:hover,.site-footer .footer-bottom a:hover { color:var(--accent); }
    .site-footer .footer-bottom { display:flex; flex-wrap:wrap; align-items:center; gap:12px 28px; padding-block:20px; border-top:1px solid var(--line); color:var(--muted); font-size:11px; }
    .site-footer .footer-bottom a { margin-left:auto; display:inline-flex; align-items:center; min-height:44px; }
    .site-footer .footer-draft-note { color:#83898d; }
    .site-footer .legal-panel { padding-block:48px 64px; }
    .site-footer .legal-panel:focus-visible { outline:none; }
    .site-footer .legal-panel:focus-visible .legal-heading h2 { text-decoration:underline; text-decoration-color:var(--accent); text-decoration-thickness:2px; text-underline-offset:8px; }
    .site-footer .legal-heading { max-width:960px; align-items:flex-start; }
    .site-footer .legal-heading h2 { font-size:30px; line-height:1.3; padding-top:3px; }
    .site-footer .legal-close { flex-shrink:0; color:var(--accent); }
    .site-footer .legal-template { max-width:760px; padding:14px 18px; margin:22px 0 32px; border-left:2px solid var(--accent); background:#11191a; color:#a8b4b1; font-size:12px; }
    .site-footer .legal-template strong { font-weight:500; color:var(--ink); }
    .site-footer .legal-details { max-width:960px; grid-template-columns:minmax(165px,1fr) 2.6fr; gap:20px 40px; }
    .site-footer .legal-details dt { font-weight:400; font-size:13px; }
    .site-footer .legal-details dd { color:#a6a8ab; font-size:13px; }
    .site-footer .legal-lead { color:var(--muted); margin:16px 0 0; font-size:14px; }
    .site-footer .legal-related { display:flex; gap:24px; flex-wrap:wrap; margin-top:30px; }
    .site-footer .legal-related a { display:inline-flex; align-items:center; min-height:44px; font-size:12px; color:var(--accent); }
    .site-footer .legal-related a:hover { text-decoration:underline; text-underline-offset:4px; }
    @media(max-width:1000px) {
      .site-footer .footer-main { gap:28px; grid-template-columns:1.3fr 1fr 1.2fr 1fr; }
    }
    @media(max-width:760px) {
      .site-footer .footer-main { grid-template-columns:1fr 1fr; gap:24px; padding-block:36px 30px; }
      .site-footer .footer-identity { grid-column:1 / -1; margin-bottom:4px; }
      .site-footer .footer-identity p br { display:none; }
      .site-footer .footer-column h2 { margin:0 0 10px; }
      .site-footer .footer-column a { min-height:44px; font-size:12px; }
