    @media(max-width:760px) {
    }
    @media(prefers-reduced-motion:reduce) {
      html {
        scroll-behavior:auto;
      }
      *,*::before,*::after {
        animation:none!important;
        transition:none!important;
      }
    }
    @media(forced-colors:active) {
      .button {
        border:1px solid ButtonText;
      }
    }


    /* The approved photographs share one fixed frame; only opacity changes. */
    .site-header { position:absolute; z-index:3; top:0; width:100%; border:0; background:transparent; isolation:isolate; }
    .site-header::before { content:""; position:absolute; z-index:-1; inset:0 0 -12px; background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,0)); pointer-events:none; }
    .header-inner { width:calc(100% - 80px); max-width:none; height:84px; }
    .wordmark { font-size:22px; }
    .wordmark,.header-nav a { color:#f4f5f2; }
    .header-nav { gap:32px; }
    .header-nav a { font-size:12px; }
    .header-nav .nav-cta { margin-left:0; padding:9px 13px; border:1px solid rgba(255,255,255,.34); border-radius:2px; }
    .header-statement { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:#c3c5c2; font-size:9px; letter-spacing:.06em; white-space:nowrap; }
    .hero { color:#141615; background:#ededeb; overflow:hidden; }
    .hero-photo { position:relative; margin:0; height:auto; min-height:0; aspect-ratio:1942 / 809; overflow:hidden; background:#ededeb; }
    .hero-photo img { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; }
    .hero-photo img + img { position:absolute; inset:0; opacity:0; }
    .hero-photo::after { content:""; position:absolute; pointer-events:none; inset:auto 0 0; height:50px; background:linear-gradient(transparent,#ededeb); }
    /* A 4.5-second hold and two-second fade give each scene a 6.5-second slot.
       Earlier overlays fade out only after the next is opaque, avoiding three-way blends. */
    {% for subject, word, file, width, description in hero_slides %}{% if not loop.first %}
    @keyframes hero-{{ subject }}-crossfade {
      0%,{{ (loop.index0 * hero_slide_seconds - hero_crossfade_seconds) * 100 / hero_cycle_seconds }}% { opacity:0; }
      {{ loop.index0 * hero_slide_seconds * 100 / hero_cycle_seconds }}%,{{ (hero_cycle_seconds - hero_crossfade_seconds if loop.last else loop.index * hero_slide_seconds) * 100 / hero_cycle_seconds }}% { opacity:1; }
      {% if not loop.last %}{{ (loop.index * hero_slide_seconds + hero_crossfade_seconds) * 100 / hero_cycle_seconds }}%,{% endif %}100% { opacity:0; }
    }
    {% endif %}{% endfor %}
    /* SmoothUI Fade Through (https://smoothui.dev/docs/components/fade-through):
       One-second exit, then one-second enter, spanning the image's two-second fade.
       Swap at the photo crossfade midpoint; each word shares its image's phase. */
    @keyframes hero-word-fade-through {
      0%,{{ (hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}% {
        opacity:0; transform:translateY(6px) scale(.99); filter:blur(2px);
        animation-timing-function:cubic-bezier(.2,0,0,1);
      }
      {{ hero_slide_seconds * 100 / hero_cycle_seconds }}%,{{ (2 * hero_slide_seconds - hero_crossfade_seconds) * 100 / hero_cycle_seconds }}% {
        opacity:1; transform:translateY(0) scale(1); filter:blur(0);
        animation-timing-function:cubic-bezier(.4,0,1,1);
      }
      {{ (2 * hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}%,100% { opacity:0; transform:translateY(-4px) scale(1); filter:blur(0); }
    }
    /* Only the current word contributes its natural width. Switch layout when
       the outgoing word is fully transparent and the next starts entering. */
    @keyframes hero-word-layout {
      0%,{{ (2 * hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}%,100% { position:absolute; }
      {{ (hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}% { position:relative; }
    }
    @media (prefers-reduced-motion:no-preference) {
      {% for subject, word, file, width, description in hero_slides %}{% if not loop.first %}
      .hero-photo--{{ subject }} { animation:hero-{{ subject }}-crossfade {{ hero_cycle_seconds }}s ease-in-out infinite; }
      {% endif %}{% endfor %}
      .hero-word {
        animation:hero-word-fade-through {{ hero_cycle_seconds }}s linear var(--word-delay) infinite,
                  hero-word-layout {{ hero_cycle_seconds }}s steps(1,end) var(--word-delay) infinite;
      }
    }
    .hero-title { position:relative; text-align:center; padding:18px 32px 46px; }
    .hero-title > .mono { margin:0 0 17px; color:#656864; font-size:9px; letter-spacing:.12em; }
    .hero h1 { font-size:clamp(42px,4.9vw,72px); font-weight:400; line-height:1.06; letter-spacing:-.05em; }
    .hero-title .hero-promise { font-size:clamp(20px,2vw,27px); line-height:1.3; color:#646762; letter-spacing:-.025em; margin:10px 0 0; }
    .hero-words { display:inline-grid; position:relative; vertical-align:baseline; white-space:nowrap; }
    .hero-word { grid-area:1 / 1; position:absolute; opacity:0; font-weight:700; color:#111313; }
    .hero-word--bridge { position:relative; opacity:1; }
    {% for subject, word, file, width, description in hero_slides %}
    .hero-word--{{ subject }} { --word-delay:{{ (loop.index0 - 1) * hero_slide_seconds }}s; }
    {% endfor %}
    .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
    .hero-summary { display:flex; justify-content:space-between; align-items:center; gap:40px; max-width:980px; margin:30px auto 0; padding-top:20px; border-top:1px solid #cdd0ca; text-align:left; }
    .hero-summary p { max-width:520px; margin:0; color:#595e57; font-size:14px; line-height:1.6; }
    .hero-summary a { color:#171a17; border-bottom:1px solid #92958e; gap:30px; white-space:nowrap; }
    @media(max-width:1000px) {
      .header-statement { display:none; }
      .hero-summary { gap:32px; }
    }
    @media(max-width:760px) {
      .header-inner { width:calc(100% - 40px); height:72px; }
      .wordmark { font-size:21px; }
      .header-nav { gap:0; }
      .header-nav .nav-cta { padding:8px 10px; }
      .hero-photo { height:clamp(340px,48svh,440px); aspect-ratio:auto; }
      .hero-title { padding:16px 22px 36px; }
      .hero-title > .mono { max-width:310px; font-size:8px; line-height:1.6; margin:0 auto 17px; }
      .hero h1 { font-size:44px; max-width:390px; line-height:1.04; margin:auto; }
      .hero-title .hero-promise { margin-top:13px; font-size:21px; }
      .hero-summary { align-items:flex-start; flex-direction:column; gap:16px; margin-top:25px; padding-top:18px; }
      .hero-summary p { font-size:13px; }
      .hero-summary a { font-size:12px; }
    }
    /* Product overview: every selector is scoped below the approved hero. */
    /* Match the application's dark-theme primary in frontend/src/App.css. */
    .product-overview,.site-footer { --product-accent:164 28% 64%; --accent:hsl(var(--product-accent)); --product-line:hsl(var(--product-accent) / .55); }
    .product-overview .product-intro { display:grid; grid-template-columns:1fr 2.1fr; gap:60px; margin-bottom:64px; }
    .product-overview .product-intro p { max-width:600px; margin:24px 0 0; color:#a6a8ab; font-size:17px; line-height:1.7; }
    .product-overview .product-workspaces { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin:0 0 42px; border-top:1px solid #505357; }
    .product-overview .product-workspaces>div { padding:24px 20px 0 0; }
    .product-overview .product-workspaces dt { color:var(--muted); margin:0 0 10px; }
    .product-overview .product-workspaces dd { margin:0; font-size:19px; letter-spacing:-.035em; }
    .product-overview .product-figure { margin:0; }
    .product-overview .product-screen-frame { overflow:hidden; border:1px solid #35393c; border-radius:5px; background:#171b1f; box-shadow:0 28px 90px #0003; }
    .product-overview .product-screen-label { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:16px 22px; background:#111416; border-bottom:1px solid #35393c; color:#b0b5b7; font-size:9px; }
    .product-overview .product-screen-label span:last-child { color:var(--accent); }
    .product-overview .product-screenshot { display:block; width:100%; height:auto; }
    .product-overview .product-caption { display:grid; grid-template-columns:1fr 1fr; gap:60px; padding-top:34px; }
    .product-overview .product-caption h3 { margin:0; font-size:30px; line-height:1.2; }
    .product-overview .product-caption p { margin:0; color:#a6a8ab; font-size:14px; max-width:560px; }
    .product-overview .product-caption .product-image-note { margin-top:14px; font-size:11px; color:#81868a; }
    .product-overview .product-band { border-block:1px solid var(--line); background:#0e1012; }
    .product-overview .product-split { display:grid; grid-template-columns:1fr 1fr; gap:100px; align-items:start; margin-top:34px; }
    .product-overview .product-copy h2 { font-size:clamp(34px,3.5vw,50px); }
    .product-overview .product-copy>p { color:#a6a8ab; max-width:490px; font-size:15px; line-height:1.8; margin:24px 0 32px; }
    .product-overview .product-details { margin:0; }
    .product-overview .product-details>div { border-top:1px solid var(--line); padding:20px 0; }
    .product-overview .product-details>div:last-child { padding-bottom:0; }
    .product-overview .product-details dt { font-size:16px; letter-spacing:-.025em; margin-bottom:6px; }
    .product-overview .product-details dd { color:var(--muted); font-size:13px; margin:0; max-width:440px; line-height:1.8; }
    .product-overview .product-flow { margin:6px 0 0; padding:36px; background:radial-gradient(#424c4a66 .65px,transparent .65px),#111619; background-size:16px 16px; border:1px solid #30383b; border-radius:5px; }
    .product-overview .product-flow figcaption { color:#a8b3b1; margin-bottom:46px; font-size:9px; }
    .product-overview .product-flow-inputs { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
    .product-overview .product-flow-inputs>span { display:flex; align-items:center; justify-content:center; gap:10px; background:#182021; border:1px solid hsl(var(--product-accent) / .3); padding:14px 8px; font-size:12px; white-space:nowrap; }
    .product-overview .product-flow-inputs i { width:5px; height:5px; border:1px solid var(--accent); border-radius:50%; }
    .product-overview .product-flow-join { width:calc(50% + 12px); height:27px; margin:0 auto 27px; border:solid var(--product-line); border-width:0 1px 1px; position:relative; }
    .product-overview .product-flow-join::after { content:""; position:absolute; height:27px; top:100%; left:50%; border-left:1px solid var(--product-line); }
    .product-overview .product-flow-steps { list-style:none; padding:0; margin:0; }
    .product-overview .product-flow-steps li { position:relative; display:flex; gap:20px; padding:21px 22px; background:#181e20; border:1px solid hsl(var(--product-accent) / .3); }
    .product-overview .product-flow-steps li+li { margin-top:28px; }
    .product-overview .product-flow-steps li+li::before { content:""; height:28px; position:absolute; bottom:100%; left:50%; border-left:1px solid var(--product-line); }
    .product-overview .product-flow-index { padding-top:4px; color:var(--accent); }
    .product-overview .product-flow-steps strong { display:block; font-size:16px; font-weight:400; letter-spacing:-.025em; }
    .product-overview .product-flow-steps div>span { display:block; font-size:12px; color:#a4aeac; margin-top:4px; }
    .product-overview .product-flow-note { margin:30px 0 0; font-size:11px; text-align:center; color:#919d9a; }
    .product-overview .product-docs-link { border-bottom:1px solid var(--product-line); font-size:12px; margin-top:4px; padding-bottom:6px; }
    .product-overview .product-docs-link .arrow { color:var(--accent); }
    .product-overview .product-replay { margin:0; padding:0; list-style:none; }
    .product-overview .product-replay li { border-top:1px solid #3a3d40; padding:24px 0 28px; }
    .product-overview .product-replay li:first-child { padding-top:0; border:0; }
    .product-overview .product-replay li>span { color:var(--accent); font-size:9px; }
    .product-overview .product-replay h3 { margin:12px 0 10px; font-size:24px; }
    .product-overview .product-replay p { margin:0; max-width:470px; font-size:14px; line-height:1.8; color:#a6a8ab; }
    .product-overview .product-loop { display:flex; align-items:center; gap:26px; border-top:1px solid var(--line); padding-top:28px; margin-top:50px; color:#bfc1be; font-size:9px; }
    .product-overview .product-loop>span[aria-hidden] { color:var(--accent); }
    .product-overview .product-loop-note { margin-left:auto; color:#80868a; text-transform:none; letter-spacing:0; font-family:"Helvetica Neue",Helvetica,Arial,sans-serif; font-size:12px; }
    @media(max-width:1100px) {
      .product-overview .product-split { gap:48px; }
      .product-overview .product-flow { padding:28px 20px; }
      .product-overview .product-flow-inputs { gap:16px; }
      .product-overview .product-workspaces dd { font-size:17px; }
    }
    @media(max-width:760px) {
      .product-overview .product-intro { grid-template-columns:1fr; gap:26px; margin-bottom:36px; }
      .product-overview .product-intro p { font-size:15px; margin-top:20px; }
      .product-overview .product-workspaces { grid-template-columns:1fr 1fr; gap:24px 12px; padding-top:22px; margin-bottom:28px; }
      .product-overview .product-workspaces>div { padding:0; }
      .product-overview .product-workspaces dt { font-size:9px; margin-bottom:6px; }
      .product-overview .product-workspaces dd { font-size:17px; }
      .product-overview .product-screen-label { font-size:7px; padding:12px 10px; gap:10px; }
      .product-overview .product-caption { grid-template-columns:1fr; gap:18px; padding-top:26px; }
      .product-overview .product-caption h3 { font-size:28px; }
      .product-overview .product-caption p { font-size:13px; }
      .product-overview .product-split { grid-template-columns:1fr; gap:36px; margin-top:26px; }
      .product-overview .product-copy h2 { font-size:36px; }
      .product-overview .product-copy>p { font-size:14px; margin:20px 0 28px; }
      .product-overview .product-flow { margin:0; padding:26px 18px; }
      .product-overview .product-flow figcaption { margin-bottom:30px; }
      .product-overview .product-flow-steps li { gap:15px; padding:18px 15px; }
      .product-overview .product-flow-steps strong { font-size:15px; }
      .product-overview .product-flow-steps div>span { font-size:11px; }
      .product-overview .product-flow-inputs>span { font-size:11px; gap:7px; }
      .product-overview .product-replay h3 { font-size:23px; }
      .product-overview .product-replay p { font-size:13px; }
      .product-overview .product-loop { gap:10px; justify-content:space-between; font-size:7px; margin-top:28px; }
      .product-overview .product-loop-note { display:none; }
      .product-overview .closing h2 { font-size:48px; }
    }
    /* End product overview. */
  </style>
</head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="container header-inner">
<a class="wordmark" href="#main" aria-label="Aberration home"><svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 10H38V20H20V54H10ZM44 10H54V54H26V44H44Z"/></svg><span>aberration</span></a>
<span class="header-statement mono">Real-time decision-making.</span>
<nav class="header-nav" aria-label="Main navigation"><a class="nav-cta" href="{{ frontend_base_url | e }}/">Dashboard <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
<path d="M7 17 17 7M7 7h10v10"/></svg></a></nav>
</div></header><main id="main">
<section class="hero" aria-labelledby="headline">
  <figure class="hero-photo">
    {% for subject, word, file, width, description in hero_slides %}
    <img class="hero-photo--{{ subject }}" src="/assets/{{ file }}" width="{{ width }}" height="809" {% if loop.first %}fetchpriority="high"{% else %}decoding="async"{% endif %} alt="Generated photograph looking along the underside of {{ description }}.">
    {% endfor %}
  </figure>
  <div class="hero-title">
    <p class="mono">Anomaly detection for physical &amp; digital systems</p>
    <h1 id="headline">Every system has a pattern.</h1>
    <p class="hero-promise"><span class="visually-hidden">Detect when strain, traffic, flow, quality, yield, efficiency, precision or pressure changes.</span><span aria-hidden="true"><span class="hero-promise-prefix">Detect when </span><span class="hero-words">{% for subject, word, file, width, description in hero_slides %}<span class="hero-word hero-word--{{ subject }}">{{ word }}</span>{% endfor %}</span><span class="hero-promise-suffix"> changes.</span></span></p>
    <div class="hero-summary">
      <p>Continuous anomaly detection for sensor telemetry<br>and digital data streams.</p>
      <a class="text-link" href="#platform">Explore the platform <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
<div class="product-overview">
  <section class="section container" id="platform" aria-labelledby="platform-title">
    <div class="product-intro">
      <div class="section-label mono"><b>01 /</b> The platform</div>
      <div>
        <h2 id="platform-title">From raw signal.<br><span class="muted">To informed decision.</span></h2>
        <p>Bring your readings into one workspace. Build monitors around your system, investigate the changes they flag, and test your next design on recorded data.</p>
      </div>
    </div>
    <dl class="product-workspaces">
      <div><dt class="mono">Sources</dt><dd>Connect &amp; record.</dd></div>
      <div><dt class="mono">Monitoring</dt><dd>Design &amp; detect.</dd></div>
      <div><dt class="mono">Reporting</dt><dd>Inspect &amp; understand.</dd></div>
      <div><dt class="mono">Dojo</dt><dd>Replay &amp; refine.</dd></div>
    </dl>
    <figure class="product-figure">
      <div class="product-screen-frame">
        <div class="product-screen-label mono"><span>Inside the platform / Reporting</span><span>Example data</span></div>
<!-- BEGIN PRODUCT SCREENSHOT -->
<img class="product-screenshot" src="data:image/webp;base64," width="1440" height="1000" loading="lazy" decoding="async" alt="Aberration Reporting: outlet pressure and its detection evidence on a shared timeline, with an example change marked in the reading.">
<!-- END PRODUCT SCREENSHOT -->
      </div>
      <figcaption class="product-caption">
        <h3>See the change.<br><span class="muted">Keep the context.</span></h3>
        <div><p>Inspect a detected change alongside the readings behind it. Follow the original signal and the detection evidence on a shared timeline, then zoom in on the period that matters.</p><p class="product-image-note">Actual product interface · illustrative cooling-circuit data.</p></div>
      </figcaption>
    </figure>
  </section>

  <section class="section product-band" id="monitoring" aria-labelledby="monitoring-title">
    <div class="container">
      <div class="section-label mono"><b>02 /</b> Sources &amp; monitoring</div>
      <div class="product-split">
        <div class="product-copy">
          <h2 id="monitoring-title">Build a monitor<br><span class="muted">around your system.</span></h2>
          <p>A single reading or a set of related signals. A fixed reference or a baseline that adapts. Shape the detection to the way your system behaves.</p>
          <dl class="product-details">
            <div><dt>Choose what to collect.</dt><dd>Connect MQTT sources, organise their readings, and decide what to record. Keep the history you need for monitoring and investigation.</dd></div>
            <div><dt>Make the logic visible.</dt><dd>Prepare and combine signals, choose detection steps, and connect them in a visual pipeline. Save a design to use again.</dd></div>
            <div><dt>Follow it as it runs.</dt><dd>See monitor status and review the evidence as new readings arrive. Move from a flagged change back to the underlying data.</dd></div>
          </dl>
        </div>
        <figure class="product-flow" aria-labelledby="flow-caption">
          <figcaption id="flow-caption" class="mono">An example monitoring flow</figcaption>
          <div class="product-flow-inputs"><span><i aria-hidden="true"></i>Outlet pressure</span><span><i aria-hidden="true"></i>Flow rate</span></div>
          <div class="product-flow-join" aria-hidden="true"></div>
          <ol class="product-flow-steps">
            <li><span class="product-flow-index mono">01</span><div><strong>Prepare &amp; combine</strong><span>Turn related readings into useful signals.</span></div></li>
            <li><span class="product-flow-index mono">02</span><div><strong>Learn &amp; detect</strong><span>Establish a reference. Look for departures.</span></div></li>
            <li><span class="product-flow-index mono">03</span><div><strong>Collect the evidence</strong><span>Keep the scores and decisions for review.</span></div></li>
          </ol>
          <p class="product-flow-note">Designed visually. Applied as the data arrives.</p>
        </figure>
      </div>
    </div>
  </section>

  <section class="section container" id="dojo" aria-labelledby="dojo-title">
    <div class="section-label mono"><b>03 /</b> The Dojo</div>
    <div class="product-split product-dojo">
      <div class="product-copy">
        <h2 id="dojo-title">Try it on the past.<br><span class="muted">Before it watches<br>the present.</span></h2>
        <p>Replay recorded readings or a CSV through a detection pipeline. See what it would have flagged, compare your options, and take a tested design into monitoring.</p>
        {% if docs_base_url | default('') %}<a class="text-link product-docs-link" href="{{ docs_base_url | e }}/user-guide/monitoring/">Explore the workflow <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>{% endif %}
      </div>
      <ol class="product-replay">
        <li><span class="mono">01 / Replay</span><div><h3>Give a design some history.</h3><p>Choose recorded data or upload a dataset. Replay it in time order through the same detection logic used in live monitoring.</p></div></li>
        <li><span class="mono">02 / Compare</span><div><h3>Find out what it catches.</h3><p>Label known events and compare runs. Look at detected changes, detection delays, and false alarms together.</p></div></li>
        <li><span class="mono">03 / Refine</span><div><h3>Take the better design forward.</h3><p>Adjust the pipeline, run it again, and reuse the design in monitoring when you are ready.</p></div></li>
      </ol>
    </div>
    <div class="product-loop mono"><span>Recorded data</span><span aria-hidden="true">→</span><span>Test &amp; compare</span><span aria-hidden="true">→</span><span>Live monitoring</span><span class="product-loop-note">One workflow. Room to improve.</span></div>
  </section>

  <section class="closing" aria-labelledby="closing-title"><div class="container closing-inner"><div><p class="mono">Connect. Detect. Understand.</p><h2 id="closing-title">Start with a signal.</h2></div><a class="button" href="{{ frontend_base_url | e }}/">Open dashboard <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div></section>
</div>
</main>  <footer class="site-footer" id="site-footer" tabindex="-1">
    <div class="container footer-inner">
      <p class="footer-brand">aberration<span class="footer-extra"> &nbsp; / &nbsp; Detection infrastructure.</span></p>
      <nav class="footer-links" aria-label="Legal information">
        <a href="#impressum">Impressum</a>
        <a href="#privacy">Privacy</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
    <section class="container legal-panel" id="impressum" aria-labelledby="impressum-heading" tabindex="-1">
      <div class="legal-heading">
        <h2 id="impressum-heading">Impressum</h2>
        <a class="legal-close" href="#site-footer">Close</a>
      </div>
      <p class="legal-template">Template — replace the bracketed fields with the operator’s verified details before publication.</p>
      <dl class="legal-details">
        <dt>Operator</dt><dd>[Full legal name / organisation]</dd>
        <dt>Address</dt><dd>[Street and number]<br>[Postcode, city, country]</dd>
        <dt>Contact</dt><dd>[Email address]<br>[Telephone number]</dd>
        <dt>Representation &amp; registration</dt><dd>[Representative, register and registration number, where applicable]</dd>
        <dt>Tax information</dt><dd>[VAT ID / tax information, where applicable]</dd>
      </dl>
    </section>
    <section class="container legal-panel" id="privacy" aria-labelledby="privacy-heading" tabindex="-1">
      <div class="legal-heading">
        <h2 id="privacy-heading">Privacy</h2>
        <a class="legal-close" href="#site-footer">Close</a>
      </div>
      <p class="legal-template">Template — replace the bracketed fields with an accurate description of this website and the dashboard before publication.</p>
      <dl class="legal-details">
        <dt>Responsible party</dt><dd>[Name and contact details of the data controller]</dd>
        <dt>Data &amp; purposes</dt><dd>[Describe personal data collected, purposes and legal bases]</dd>
        <dt>Providers &amp; transfers</dt><dd>[List hosting and service providers and any data transfers]</dd>
        <dt>Storage &amp; cookies</dt><dd>[Describe retention, cookies and local storage]</dd>
        <dt>Your choices &amp; rights</dt><dd>[Explain how to exercise data rights and whom to contact]</dd>
      </dl>
    </section>
    <section class="container legal-panel" id="contact" aria-labelledby="contact-heading" tabindex="-1">
      <div class="legal-heading">
        <h2 id="contact-heading">Contact</h2>
        <a class="legal-close" href="#site-footer">Close</a>
      </div>
      <p class="legal-template">Template — replace the bracketed fields with the contact details you want to publish.</p>
      <dl class="legal-details">
        <dt>Email</dt><dd>[Contact email address]</dd>
        <dt>Telephone</dt><dd>[Contact telephone number]</dd>
        <dt>Post</dt><dd>[Organisation / contact person]<br>[Street and number]<br>[Postcode, city, country]</dd>
      </dl>
    </section>
  </footer>
</body>
</html>
