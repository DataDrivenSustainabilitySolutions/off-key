      .section-intro,.research {
        grid-template-columns:1fr 2.4fr;
        gap:35px;
      }
      .step+.step {
        padding-left:18px;
      }
      .step {
        padding-right:18px;
      }
    }
    @media(max-width:760px) {
      .container {
        width:calc(100% - 40px);
      }
      .header-inner {
        height:76px;
        gap:20px;
      }
      .wordmark {
        font-size:22px;
      }
      .brand-mark {
        width:28px;
        height:28px;
      }
      .header-nav {
        gap:0;
      }
      .header-nav .nav-cta {
        margin:0;
        padding:0 12px;
        font-size:11px;
        gap:13px;
      }
      h1 {
        font-size:clamp(46px,10.8vw,78px);
        letter-spacing:-.067em;
      }
      .button {
        padding-inline:17px;
        gap:25px;
      }
      .section {
        padding-block:65px;
      }
      .section-intro,.research {
        grid-template-columns:1fr;
        gap:25px;
        margin-bottom:35px;
      }
      .section-label {
        font-size:9px;
        padding:0;
      }
      .section-intro p {
        font-size:13px;
      }
      h2 {
        font-size:38px;
      }
      .pipeline {
        grid-template-columns:1fr 1fr;
      }
      .step {
        padding:23px 18px 27px 0;
      }
      .step+.step {
        padding-left:18px;
      }
      .step:nth-child(3) {
        border-left:0;
        padding-left:0;
        border-top:1px solid var(--line);
      }
      .step:nth-child(4) {
        border-top:1px solid var(--line);
      }
      .step h3 {
        font-size:23px;
        margin-top:23px;
      }
      .step p {
        font-size:12px;
      }
      .step-visual {
