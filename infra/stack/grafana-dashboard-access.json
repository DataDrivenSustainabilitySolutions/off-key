  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Reading this dashboard",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**Production disables successful-request and performance logging.** These panels show recorded exceptions and access events; they cannot provide request throughput, total 4xx/5xx counts, availability or overall latency.\n\nAccess warnings are **throttled per event/client over 60s**. A later warning reports suppressed occurrences; a quiet tail may never report them. Suspicious-pattern matches are diagnostic hints, not confirmed attacks. IDs and paths remain in records, not chart series."
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "row",
      "title": "Recorded symptoms · selected time range",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP exceptions",
      "description": "http.request_failed records only; handled HTTP errors and successful requests are not included.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({stack=~`${stack:regex}`,node=~`${node:regex}`,service=~`${stack:regex}_(api)`} |= \"event=\" | json msg=\"message\" | __error__=\"\" | msg=~`(?s)^event=(http[.]request_failed)( .*|$)` | drop msg [$__range])) or (0 * sum(count_over_time({stack=~`${stack:regex}`,node=~`${node:regex}`,service=~`${stack:regex}_(api)`} [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{service}}"
        }
      ],
      "interval": "1m",
      "maxDataPoints": 180,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No observations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
