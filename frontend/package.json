    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "3.14.20",
    "@tisoap/react-flow-smart-edge": "5.0.0",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
