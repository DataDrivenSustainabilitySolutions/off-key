  <figure class="hero-photo">
    <img src="{{ hero_bridge }}" width="1942" height="809" fetchpriority="high" alt="Generated photograph looking along the underside of a steel bridge.">
    <img class="hero-photo--pipes" src="{{ hero_pipes }}" width="1944" height="809" decoding="async" alt="Generated photograph looking along an overhead industrial pipe rack.">
