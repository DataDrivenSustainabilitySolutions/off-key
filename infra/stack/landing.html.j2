    /* The approved photographs share one fixed frame; only opacity changes. */
    .site-header { position:absolute; z-index:3; top:0; width:100%; border:0; background:transparent; isolation:isolate; }
    .site-header::before { content:""; position:absolute; z-index:-1; inset:0 0 -12px; background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,0)); pointer-events:none; }
    .header-inner { width:calc(100% - 80px); max-width:none; height:84px; }
    .wordmark { font-size:22px; }
    .wordmark,.header-nav a { color:#f4f5f2; }
    .header-nav { gap:32px; }
    .header-nav a { font-size:12px; }
    .header-nav .nav-cta { margin-left:0; padding:9px 13px; border:1px solid rgba(255,255,255,.34); border-radius:2px; }
    .header-statement { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:#c3c5c2; font-size:9px; letter-spacing:.06em; white-space:nowrap; }
    .hero { color:#141615; background:#ededeb; overflow:hidden; }
    .hero-photo { position:relative; margin:0; height:auto; min-height:0; aspect-ratio:1942 / 809; overflow:hidden; background:#ededeb; }
    .hero-photo img { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; }
    .hero-photo img + img { position:absolute; inset:0; opacity:0; }
    .hero-photo::after { content:""; position:absolute; pointer-events:none; inset:auto 0 0; height:50px; background:linear-gradient(transparent,#ededeb); }
    /* Eight seconds per photograph, with two-second fades in a forty-second loop.
       Earlier overlays fade out only after the next is opaque, avoiding three-way blends. */
    @keyframes hero-pipes-crossfade {
      0%,20%,55%,100% { opacity:0; }
      25%,50% { opacity:1; }
    }
    @keyframes hero-conveyor-crossfade {
      0%,45%,80%,100% { opacity:0; }
      50%,75% { opacity:1; }
    }
    @keyframes hero-solar-crossfade {
      0%,70% { opacity:0; }
      75%,95% { opacity:1; }
      100% { opacity:0; }
    }
    @media (prefers-reduced-motion:no-preference) {
      .hero-photo--pipes { animation:hero-pipes-crossfade 40s ease-in-out infinite; }
      .hero-photo--conveyor { animation:hero-conveyor-crossfade 40s ease-in-out infinite; }
      .hero-photo--solar { animation:hero-solar-crossfade 40s ease-in-out infinite; }
    }
    .hero-title { position:relative; text-align:center; padding:18px 32px 46px; }
    .hero-title > .mono { margin:0 0 17px; color:#656864; font-size:9px; letter-spacing:.12em; }
    .hero h1 { font-size:clamp(42px,4.9vw,72px); font-weight:400; line-height:1.06; letter-spacing:-.05em; }
    .hero-title .hero-promise { font-size:clamp(20px,2vw,27px); line-height:1.3; color:#646762; letter-spacing:-.025em; margin:10px 0 0; }
    .hero-summary { display:flex; justify-content:space-between; align-items:center; gap:40px; max-width:980px; margin:30px auto 0; padding-top:20px; border-top:1px solid #cdd0ca; text-align:left; }
    .hero-summary p { max-width:520px; margin:0; color:#595e57; font-size:14px; line-height:1.6; }
    .hero-summary a { color:#171a17; border-bottom:1px solid #92958e; gap:30px; white-space:nowrap; }
    @media(max-width:1000px) {
      .header-statement { display:none; }
      .hero-summary { gap:32px; }
    }
    @media(max-width:760px) {
      .header-inner { width:calc(100% - 40px); height:72px; }
