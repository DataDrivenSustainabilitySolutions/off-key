services:
  # The broker reads its password file after dropping to the mosquitto user, so
  # these secrets belong to that user (uid 1883) and no one else can read them.
  mosquitto:
    configs:
      - source: mosquitto_cfg
        target: /mosquitto/config/mosquitto.conf
    secrets:
      - source: mqtt_server_cert
        target: mqtt_server_cert.pem
        uid: "1883"
        gid: "1883"
        mode: 0400
      - source: mqtt_server_key
        target: mqtt_server_key.pem
        uid: "1883"
        gid: "1883"
        mode: 0400
      - source: mosquitto_passwords
        target: mosquitto_passwords
        uid: "1883"
        gid: "1883"
        mode: 0400

  # Live views, broker checks and the composer's model list run in the API; the
  # worker records sources and submits RADAR workloads. Both read the same credentials.
  api:
    secrets: &domain_secrets
      - source: mqtt_ca_cert
        target: MQTT_CA_CERT
      - source: mqtt_proxy_password
        target: SYSTEM_COLLECTION_MQTT_API_KEY
      # Asked which models the forecast service holds, for the composer.
      - source: forecast_api_token
        target: FORECAST_API_TOKEN
{% if 'system_broker_routes' in deployment_secret_names %}
      - source: system_broker_routes
        target: SYSTEM_BROKER_ROUTES
{% endif %}

  tactic:
    secrets: *domain_secrets

  mqtt-proxy:
    environment:
      MQTT_CA_FILE: /run/secrets/MQTT_CA_CERT
    secrets:
      - source: mqtt_ca_cert
        target: MQTT_CA_CERT
      - source: mqtt_proxy_password
        target: MQTT_APIKEY

  # Monitors read the stored telemetry log, so the pool holds no broker login.
  mqtt-radar:
    secrets:
      - source: radar_checkpoint_secret
        target: RADAR_CHECKPOINT_SECRET
      # Read by the monitors the pool runs.
      - source: forecast_api_token
        target: FORECAST_API_TOKEN

  dojo-worker:
    secrets:
      - source: forecast_api_token
        target: FORECAST_API_TOKEN

  forecast:
    secrets:
      - source: forecast_api_token
        target: FORECAST_API_TOKEN

configs:
  mosquitto_cfg:
    name: ${CONFIG_NAME_PREFIX}mosquitto_cfg_${MOSQUITTO_CONFIG_HASH}
    file: ./mosquitto.conf

# Shared declarations; each service above mounts only the credentials it needs.
secrets:
{% for key, name in deployment_secret_names.items() %}
  {{ key }}:
    external: true
    name: {{ name }}
{% endfor %}
