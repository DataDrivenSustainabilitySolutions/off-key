    @media(max-width:760px) {
    }
    @media(prefers-reduced-motion:reduce) {
      html {
        scroll-behavior:auto;
      }
      *,*::before,*::after {
        animation:none!important;
        transition:none!important;
      }
    }
    @media(forced-colors:active) {
      .button {
        border:1px solid ButtonText;
      }
    }


    /* The approved photographs share one fixed frame; only opacity changes. */
    .site-header { position:absolute; z-index:3; top:0; width:100%; border:0; background:transparent; isolation:isolate; }
    .site-header::before { content:""; position:absolute; z-index:-1; inset:0 0 -12px; background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,0)); pointer-events:none; }
    .header-inner { width:calc(100% - 80px); max-width:none; height:84px; }
    .wordmark { font-size:22px; }
    .wordmark,.header-nav a { color:#f4f5f2; }
    .header-nav { gap:32px; }
    .header-nav a { font-size:12px; }
    .header-nav .nav-cta { margin-left:0; padding:9px 13px; border:1px solid rgba(255,255,255,.34); border-radius:2px; }
    .header-statement { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:#c3c5c2; font-size:9px; letter-spacing:.06em; white-space:nowrap; }
    .hero { color:#141615; background:#ededeb; overflow:hidden; }
    .hero-photo { position:relative; margin:0; height:auto; min-height:0; aspect-ratio:1942 / 809; overflow:hidden; background:#ededeb; }
    .hero-photo img { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; }
    .hero-photo img + img { position:absolute; inset:0; opacity:0; }
    .hero-photo::after { content:""; position:absolute; pointer-events:none; inset:auto 0 0; height:50px; background:linear-gradient(transparent,#ededeb); }
    /* A 4.5-second hold and two-second fade give each scene a 6.5-second slot.
       Earlier overlays fade out only after the next is opaque, avoiding three-way blends. */
    {% for subject, word, file, width, description in hero_slides %}{% if not loop.first %}
    @keyframes hero-{{ subject }}-crossfade {
      0%,{{ (loop.index0 * hero_slide_seconds - hero_crossfade_seconds) * 100 / hero_cycle_seconds }}% { opacity:0; }
      {{ loop.index0 * hero_slide_seconds * 100 / hero_cycle_seconds }}%,{{ (hero_cycle_seconds - hero_crossfade_seconds if loop.last else loop.index * hero_slide_seconds) * 100 / hero_cycle_seconds }}% { opacity:1; }
      {% if not loop.last %}{{ (loop.index * hero_slide_seconds + hero_crossfade_seconds) * 100 / hero_cycle_seconds }}%,{% endif %}100% { opacity:0; }
    }
    {% endif %}{% endfor %}
    /* SmoothUI Fade Through (https://smoothui.dev/docs/components/fade-through):
       One-second exit, then one-second enter, spanning the image's two-second fade.
       Swap at the photo crossfade midpoint; each word shares its image's phase. */
    @keyframes hero-word-fade-through {
      0%,{{ (hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}% {
        opacity:0; transform:translateY(6px) scale(.99); filter:blur(2px);
        animation-timing-function:cubic-bezier(.2,0,0,1);
      }
      {{ hero_slide_seconds * 100 / hero_cycle_seconds }}%,{{ (2 * hero_slide_seconds - hero_crossfade_seconds) * 100 / hero_cycle_seconds }}% {
        opacity:1; transform:translateY(0) scale(1); filter:blur(0);
        animation-timing-function:cubic-bezier(.4,0,1,1);
      }
      {{ (2 * hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}%,100% { opacity:0; transform:translateY(-4px) scale(1); filter:blur(0); }
    }
    /* Only the current word contributes its natural width. Switch layout when
       the outgoing word is fully transparent and the next starts entering. */
    @keyframes hero-word-layout {
      0%,{{ (2 * hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}%,100% { position:absolute; }
      {{ (hero_slide_seconds - hero_crossfade_seconds / 2) * 100 / hero_cycle_seconds }}% { position:relative; }
    }
    @media (prefers-reduced-motion:no-preference) {
      {% for subject, word, file, width, description in hero_slides %}{% if not loop.first %}
      .hero-photo--{{ subject }} { animation:hero-{{ subject }}-crossfade {{ hero_cycle_seconds }}s ease-in-out infinite; }
      {% endif %}{% endfor %}
      .hero-word {
        animation:hero-word-fade-through {{ hero_cycle_seconds }}s linear var(--word-delay) infinite,
                  hero-word-layout {{ hero_cycle_seconds }}s steps(1,end) var(--word-delay) infinite;
      }
    }
    .hero-title { position:relative; text-align:center; padding:18px 32px 46px; }
    .hero-title > .mono { margin:0 0 17px; color:#656864; font-size:9px; letter-spacing:.12em; }
    .hero h1 { font-size:clamp(42px,4.9vw,72px); font-weight:400; line-height:1.06; letter-spacing:-.05em; }
    .hero-title .hero-promise { font-size:clamp(20px,2vw,27px); line-height:1.3; color:#646762; letter-spacing:-.025em; margin:10px 0 0; }
    .hero-words { display:inline-grid; position:relative; vertical-align:baseline; white-space:nowrap; }
    .hero-word { grid-area:1 / 1; position:absolute; opacity:0; font-weight:700; color:#111313; }
    .hero-word--bridge { position:relative; opacity:1; }
    {% for subject, word, file, width, description in hero_slides %}
    .hero-word--{{ subject }} { --word-delay:{{ (loop.index0 - 1) * hero_slide_seconds }}s; }
    {% endfor %}
    .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
    .hero-summary { display:flex; justify-content:space-between; align-items:center; gap:40px; max-width:980px; margin:30px auto 0; padding-top:20px; border-top:1px solid #cdd0ca; text-align:left; }
    .hero-summary p { max-width:520px; margin:0; color:#595e57; font-size:14px; line-height:1.6; }
    .hero-summary a { color:#171a17; border-bottom:1px solid #92958e; gap:30px; white-space:nowrap; }
    @media(max-width:1000px) {
      .header-statement { display:none; }
      .hero-summary { gap:32px; }
    }
    @media(max-width:760px) {
